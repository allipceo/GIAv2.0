# ZOBIS 환경변수 템플릿
# 실제 값은 config.env 파일에 설정하세요

# Google Custom Search Engine
CSE_API_KEY=your_google_cse_api_key_here
CSE_CX=your_google_search_engine_id_here

# Notion API
NOTION_TOKEN=your_notion_integration_token_here
TARGET_DATABASE_ID=your_notion_database_id_here

# Google Drive (선택사항)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
UPLOAD_FOLDER_ID=your_google_drive_folder_id_here

# 기타 API (선택사항)
SERPAPI_KEY=your_serpapi_key_here
BING_KEY=your_bing_search_key_here
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Python 경로
PYTHONPATH=.

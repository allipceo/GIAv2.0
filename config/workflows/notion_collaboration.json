{
  "workflow_name": "Notion 협업 워크플로우",
  "version": "1.0.0",
  "description": "케이스1,2,3의 재활용 가능한 모듈화된 워크플로우",
  "cases": {
    "case1": {
      "name": "통합·권한 핸드셰이크",
      "description": "users/me, databases 엔드포인트 테스트",
      "required_steps": ["users_me", "databases"],
      "success_criteria": {
        "users_me": 200,
        "databases": 200
      }
    },
    "case2": {
      "name": "페이지 식별 및 읽기",
      "description": "키워드로 페이지 검색 및 상세 정보 조회",
      "required_steps": ["query", "page_info"],
      "success_criteria": {
        "query": "success",
        "page_info": "success"
      }
    },
    "case3": {
      "name": "뉴스클리핑 DB 등록",
      "description": "외부 뉴스를 표준 스키마로 뉴스클리핑 DB에 등록",
      "required_steps": ["health_check", "news_registration"],
      "success_criteria": {
        "health_check": "success",
        "news_registration": "success"
      }
    }
  },
  "reusable_components": {
    "notion_client": "src/utils/notion_api.py",
    "workflow_engine": "src/workflows/notion_collaboration.py",
    "config_templates": "config/workflows/",
    "log_templates": "logs/workflows/"
  },
  "execution_modes": {
    "single_case": "개별 케이스 실행",
    "full_workflow": "전체 워크플로우 실행",
    "batch_processing": "배치 처리 모드"
  },
  "output_formats": {
    "json": "구조화된 결과 데이터",
    "markdown": "사람이 읽기 쉬운 리포트",
    "log": "운영 로그"
  }
}
